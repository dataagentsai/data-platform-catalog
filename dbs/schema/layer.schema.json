{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dataagentsai/data-platform-catalog/dbs/schema/layer.schema.json",
  "title": "DBS binding layer v0.1",
  "description": "One half of a binding (decision M1, ADR-014): an engine (where tables and pipelines run) or a cloud (storage, movers, streams, identity, keys, network). Each binding entry has the same shape as in binding.schema.json. Profiles replace or remove entries for a variant of the same offering (for example Free Edition). Which ports a layer may bind is checked by the linter against binds_in in dpc/ports.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "layer", "name", "offering", "catalog", "decisions", "thresholds", "bindings", "accepted_gaps"],
  "properties": {
    "apiVersion": {"const": "data-binding-layer/v0.1"},
    "layer": {"enum": ["engine", "cloud"]},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "offering": {"type": "string", "minLength": 3},
    "catalog": {"$ref": "binding.schema.json#/properties/catalog"},
    "decisions": {"$ref": "binding.schema.json#/properties/decisions"},
    "thresholds": {"type": "object"},
    "bindings": {"type": "object", "additionalProperties": {"$ref": "binding.schema.json#/$defs/binding"}},
    "accepted_gaps": {"$ref": "binding.schema.json#/properties/accepted_gaps"},
    "profiles": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]*$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["summary"],
        "properties": {
          "summary": {"type": "string", "minLength": 10},
          "decisions": {"$ref": "binding.schema.json#/properties/decisions"},
          "thresholds": {"type": "object"},
          "bindings": {"type": "object", "additionalProperties": {"$ref": "binding.schema.json#/$defs/binding"}},
          "unbind": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "accepted_gaps": {"$ref": "binding.schema.json#/properties/accepted_gaps"}
        }
      }
    }
  }
}
